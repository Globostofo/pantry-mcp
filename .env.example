# Public URL of this server (claude.ai connector URL is $BASE_URL/mcp)
BASE_URL=https://pantry-mcp.globostofo.net

# OIDC provider "pantry-mcp" in the SSO (client type: confidential)
OIDC_CONFIG_URL=https://auth.globostofo.net/application/o/pantry-mcp/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Only SSO account allowed to use the pantry (checked on every call, on top of the SSO binding)
ALLOWED_USERNAME=assistant

# Signs the tokens this server issues to claude.ai and encrypts its OAuth state.
# Generate with: openssl rand -base64 36
# Changing it logs claude.ai out (reconnect the connector).
JWT_SIGNING_KEY=

# Grocy, reached through the heracles Docker network (service "pantry" of the pantry repo)
GROCY_URL=http://pantry
# Grocy → user menu → Manage API keys → Add (a key dedicated to this server)
GROCY_API_KEY=
