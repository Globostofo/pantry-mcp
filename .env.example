# Public HTTPS URL of this server (the MCP endpoint is $BASE_URL/mcp)
BASE_URL=https://pantry-mcp.example.com

# OIDC client registered for this server at your identity provider (confidential client,
# redirect URI $BASE_URL/auth/callback)
OIDC_CONFIG_URL=https://sso.example.com/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Only account allowed to use the pantry (OIDC claim preferred_username, checked on every call)
ALLOWED_USERNAME=

# Signs the tokens this server issues to MCP clients and encrypts its OAuth state.
# Generate with: openssl rand -base64 36
# Changing it logs every client out.
JWT_SIGNING_KEY=

# Optional: comma-separated redirect URI patterns MCP clients may register (wildcards allowed).
# Empty: any client may register; access is still limited to ALLOWED_USERNAME.
ALLOWED_REDIRECT_URIS=

# Grocy base URL, as reached from this container (keep Grocy itself off the internet)
GROCY_URL=http://grocy
# Grocy → user menu → Manage API keys → Add (a key dedicated to this server)
GROCY_API_KEY=

# Optional: time zone of the household (the default meal plan range starts "today")
TZ=UTC

# Optional: your own conventions, appended to the server instructions and to every tool
# description (language, naming, units, where to read or record house rules…)
PANTRY_INSTRUCTIONS=
